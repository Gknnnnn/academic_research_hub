# ═══════════════════════════════════════════════════════════════
# .gitignore — Academic Research Vault (MGO)
# Architecture: .git lives at ~/.git-repos/akademik_arastirma/
# (OneDrive-safe: separate-gitdir prevents corruption)
# ═══════════════════════════════════════════════════════════════

# ── OneDrive conflict copies ─────────────────────────────────
# OneDrive appends " (N)" or "- ComputerName" on sync conflicts
* (1).*
* (2).*
* (3).*
*-Mehmet MacBook Air*
*-Mehmet*MacBook*
*.~lock.*#
# OneDrive temp upload files (pattern: lu[hex].tmp)
lu*.tmp
*.tmp

# ── Office temporary files ───────────────────────────────────
~$*

# ── Large binary / non-diffable files (tracked in OneDrive, not git)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
*.zip
*.7z
*.rar
*.gz
*.tar
*.bz2
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.eps
*.tiff
*.tif
*.rds
*.rda
*.RData

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
.venv*/
*.egg-info/
.eggs/
dist/
build/

# ── R / RStudio ──────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.rdb
*.rdx
Rplots.pdf

# ── Quarto / LaTeX artifacts ─────────────────────────────────
_site/
_book/
*.tex
*.log
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
*.fdb_latexmk
*.fls

# ── Data directories (large, binary, version-controlled via DVC) ─
400-Data/
200-Manuscripts/**/_Documents-Archive/
200-Manuscripts/**/_Courses-Archive/
200-Manuscripts/**/_ARCHIVE*/

# ── Large archive & legacy dirs (OneDrive stores, not git) ───
_ARCHIVE_300-Projects/
_ARCHIVE_800-Infrastructure/
100-Literature/
110-Literature/
100-Inbox/
600-Methods/
700-Results/
800-Teaching/
900-Admin/
900-Dashboard/
950-Dossiers/
000-System/
290-Idea-Incubator/
300-Output-Registry/
400-Grants/
120-Concepts/
960-Infrastructure/lightrag_db/
960-Infrastructure/venv/
960-Infrastructure/venv_finetune/
960-Infrastructure/research_ops_ui_v1_deploy_copy/
960-Infrastructure/stage-10-watchtower/
960-Infrastructure/stage-11-evolution/
