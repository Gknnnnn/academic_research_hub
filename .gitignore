.cache/
.venv_mlx/
.dvc/
.obsidian/
.DS_Store
.quarto/
.vscode/
.playwright-cli/
node_modules/

# ── Python virtual environments (non-dotted) ─────────────────
venv/
venv_*/
env/

# ── Git recovery / backup dirs ────────────────────────────────
.git_corrupted_backup/
.git_backup*/

# ── Database & index files (LightRAG, vector DBs) ────────────
960-Infrastructure/lightrag_db/
*.db
*.sqlite
*.sqlite3

